# Goal: 클라이언트가 서버에게 요청하는 내용
int32 shape_type        # 이동할 모양 (1: 사각형, 2: 삼각형)
float32 side_length     # 한 변의 길이 (m)
int32 iterations        # 반복 횟수

# 모양 선택을 위한 상수 정의 (코드 가독성을 위해 추천)
int32 SQUARE = 1
int32 TRIANGLE = 2
---
# Result: 작업이 완료된 후 보내는 최종 결과
bool success           # 임무 성공 여부
string message         # 결과 메시지
---
# Feedback: 작업 중에 실시간으로 보내는 상태
string status          # 현재 진행 상태 (예: "Drawing square 1/1, side length 0.5m")
